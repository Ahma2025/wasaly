# ─── Core (required) ───
DATABASE_URL=postgresql://user:password@localhost:5432/wasaly
JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=production
PORT=5000

# ─── Optional core tuning ───
JWT_EXPIRE=30d
PG_POOL_MAX=30
RL_MAX=300
FREE_DELIVERY_THRESHOLD=50

# ─── Initial admin (only used when NO admin user exists yet; min 8 chars; never logged) ───
ADMIN_PHONE=
ADMIN_PASSWORD=

# ─── Development only: return/log OTP codes (ignored when NODE_ENV=production) ───
OTP_DEBUG=false

# ─── Redis (optional — enables multi-instance socket adapter + shared rate limit + response caches, brute-force counters, JWT logout denylist, live driver locations) ───
REDIS_URL=
REDIS_PRIVATE_URL=
# Cache TTLs in ms (all optional; defaults shown). Without Redis the caches fall back to per-process memory.
# CACHE_RESTAURANTS_TTL_MS=45000
# CACHE_RESTAURANT_DETAIL_TTL_MS=45000
# CACHE_POPULAR_TTL_MS=600000
# CACHE_RESTAURANT_ORDERS_TTL_MS=5000
# CACHE_ADMIN_DASHBOARD_TTL_MS=30000
# CACHE_ADMIN_ANALYTICS_TTL_MS=60000
# SOCKET_AUTH_CACHE_MS=60000
# DRIVER_LOC_PERSIST_MS=15000
# CACHE_OP_TIMEOUT_MS=250

# ─── Object storage R2/S3 (optional — all five required to enable; else images stored as base64) ───
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_REGION=auto

# ─── Push notifications ───
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT=
FCM_CONCURRENCY=50
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_BASE64=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Payments ───
LAHZA_SECRET_KEY=
PUBLIC_API_URL=https://your-api-host.example.com/api
# Stripe is disabled in code (endpoints return 503); kept for future use
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
