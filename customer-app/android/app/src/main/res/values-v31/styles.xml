<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Android 12+ (SplashScreen API): خلفية برتقالية سادة بدون أيقونة التطبيق -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/splashscreen</item>
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
  </style>
</resources>
